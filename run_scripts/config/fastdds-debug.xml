<?xml version="1.0" encoding="UTF-8" ?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <transport_descriptors>
        <transport_descriptor>
            <transport_id>usb_udp_transport</transport_id>
            <type>UDPv4</type>
            <interfaceWhiteList>
                <address>127.0.0.1</address>
                <address>192.168.55.1</address>
                <address>192.168.55.100</address>
                <address>192.168.88.5</address>
                <address>192.168.110.235</address>
                <address>172.17.0.1</address>
            </interfaceWhiteList>
        </transport_descriptor>

        <transport_descriptor>
            <transport_id>shm_transport</transport_id>
            <type>SHM</type>
        </transport_descriptor>
    </transport_descriptors>

    <!--
        ROS_DOMAIN_ID=30 FastDDS ports:
        SPDP multicast = 7400 + 250 * 30      = 14900
        SPDP unicast   = 7400 + 250 * 30 + 10 = 14910 + 2 * participant_id
        SEDP unicast   = 7400 + 250 * 30 + 11 = 14911 + 2 * participant_id

        Initial peers must include the SPDP unicast ports for every expected
        participant id. ROS launch starts several participants on one host
        (launch, gate, inference node, lifecycle helpers), so listing only
        14910 can leave later participants undiscovered.

        UFW rule: sudo ufw allow in on <usb-iface> proto udp to any port 14900:14950 comment 'fastdds-discovery'
    -->
    <participant profile_name="default_profile" is_default_profile="true">
        <rtps>
            <userTransports>
                <transport_id>usb_udp_transport</transport_id>
                <transport_id>shm_transport</transport_id>
            </userTransports>
            <useBuiltinTransports>false</useBuiltinTransports>

            <builtin>
                <initialPeersList>
                    <locator>

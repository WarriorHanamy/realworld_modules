<?xml version="1.0" encoding="UTF-8" ?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <transport_descriptors>
        <transport_descriptor>
            <transport_id>usb_udp_transport</transport_id>
            <type>UDPv4</type>
            <interfaceWhiteList>
                <address>127.0.0.1</address>
                <address>192.168.55.1</address>
                <address>192.168.55.100</address>
                <address>192.168.2.50</address>
            </interfaceWhiteList>
        </transport_descriptor>

        <transport_descriptor>
            <transport_id>shm_transport</transport_id>
            <type>SHM</type>
        </transport_descriptor>
    </transport_descriptors>

    <!--
        Port mapping for ROS_DOMAIN_ID=30 (portBase=7400, domainIDGain=250):
        SPDP multicast  = 7400 + 250*30 + 0  = 14900
        SPDP unicast    = 7400 + 250*30 + 10 + 2*pid = 14910 + 2*pid
        SEDP unicast    = 7400 + 250*30 + 11 + 2*pid = 14911 + 2*pid

        UFW rule: sudo ufw allow in on <usb-iface> proto udp to any port 14900:14950 comment 'fastdds-discovery'
    -->
    <participant profile_name="default_profile" is_default_profile="true">
        <rtps>
            <userTransports>
                <transport_id>usb_udp_transport</transport_id>
                <transport_id>shm_transport</transport_id>
            </userTransports>
            <useBuiltinTransports>false</useBuiltinTransports>

            <!-- Direct unicast discovery for USB link (multicast may be unreliable) -->
            <builtin>
                <initialPeersList>
                    <locator>
                        <udpv4>
                            <address>192.168.55.1</address>
                            <port>14900</port>
                        </udpv4>
                    </locator>
                    <locator>
                        <udpv4>
                            <address>192.168.55.100</address>
                            <port>14900</port>
                        </udpv4>
                    </locator>
                    <locator>
                        <udpv4>
                            <address>192.168.2.50</address>
                            <port>14900</port>
                        </udpv4>
                    </locator>
                </initialPeersList>
            </builtin>
        </rtps>
    </participant>
</profiles>
